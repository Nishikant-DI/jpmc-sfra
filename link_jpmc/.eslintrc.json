{
    "root": true,
    "extends": [
        "airbnb-base/legacy",
        "prettier"
    ],
    "globals": {
        "dw": true,
        "session": true,
        "request": true,
        "response": true,
        "customer": true,
        "empty": true,
        "XML": true,
        "$": true,
        "jQuery": true
    },
    "rules": {
        "import/no-unresolved": "off",
        "indent": ["error", 4, { "SwitchCase": 1, "VariableDeclarator": 1 }],
        "func-names": "off",
        "require-jsdoc": "error",
        "valid-jsdoc": ["error", { "preferType": { "Boolean": "boolean", "Number": "number", "object": "Object", "String": "string" }, "requireReturn": false}],
        "vars-on-top": "off",
        "global-require": "off",
        "no-shadow": ["error", { "allow": ["err", "callback"]}],
        "max-len": "off",
        "no-plusplus": "off",
        "no-console": "error",
        "no-alert": "error",
        "no-debugger": "error"
    },
    "overrides": [
        {
            "files": ["cartridges/*/cartridge/client/**/*.js"],
            "env": {
                "browser": true,
                "commonjs": true
            }
        }
    ]
}
