<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="JPMCClientID">
                <display-name xml:lang="x-default">JPMC Client ID</display-name>
                <description xml:lang="x-default">OAuth2 Client ID from J.P.Morgan</description>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCResourceID">
                <display-name xml:lang="x-default">JPMC Resource ID</display-name>
                <description xml:lang="x-default">OAuth2 resource ID from J.P.Morgan</description>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCAudience">
                <display-name xml:lang="x-default">JPMC Audience</display-name>
                <description xml:lang="x-default">JWT audience from J.P.Morgan</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCExpiresIn">
                <display-name xml:lang="x-default">JPMC Token Expiration</display-name>
                <description xml:lang="x-default">JWT token expiration time (e.g., 8h)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCGetKeyUrl">
                <display-name xml:lang="x-default">JPMC PIE Get Key URL</display-name>
                <description xml:lang="x-default">PIE ID from J.P.Morgan. URL for JPMC Page Integrated Encryption (PIE) getkey.js script. Example: https://safetechpageencryptionvar.chasepaymentech.com/pie/v1/YOUR_PIE_ID/getkey.js</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCEncryptionUrl">
                <display-name xml:lang="x-default">JPMC PIE Encryption URL</display-name>
                <description xml:lang="x-default">URL for JPMC Page Integrated Encryption (PIE) encryption.js script. Example: https://safetechpageencryptionvar.chasepaymentech.com/pie/v1/encryption.js</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMC_MerchantCode">
                <display-name xml:lang="x-default">JPMC Merchant Id</display-name>
                <description xml:lang="x-default">Merchant ID from J.P.Morgan. Example: YOUR_merchantId</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCPlatformId">
                <display-name xml:lang="x-default">JPMC Platform ID</display-name>
                <description xml:lang="x-default">Optional. Platform ID from J.P.Morgan. Platform identifier for JPMC APIs</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCTokenizationType">
                <display-name xml:lang="x-default">JPMC Tokenization Type</display-name>
                <description xml:lang="x-default">Default tokenization type for payment transactions. Default: SAFETECH_TOKEN</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Safetech Token</display>
                        <value>SAFETECH_TOKEN</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Network Token</display>
                        <value>NETWORK_TOKEN</value>
                    </value-definition>
                </value-definitions>
                <default-value>SAFETECH_TOKEN</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCCaptureMethod">
                <display-name xml:lang="x-default">JPMC Capture Method</display-name>
                <description xml:lang="x-default">Payment capture method: MANUAL (auth only), DELAYED (delayed capture), NOW (immediate sale). Default: MANUAL</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Manual (Authorization Only)</display>
                        <value>MANUAL</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Delayed Capture</display>
                        <value>DELAYED</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Immediate Sale (NOW)</display>
                        <value>NOW</value>
                    </value-definition>
                </value-definitions>
                <default-value>MANUAL</default-value>
            </attribute-definition>


            <attribute-definition attribute-id="JPMCEnableMultiMerchant">
                <display-name xml:lang="x-default">Enable Multi-Merchant Configuration</display-name>
                <description xml:lang="x-default">Master switch for multi-merchant functionality. When ENABLED: Uses per-locale/per-merchant configurations from custom objects and cache. When DISABLED: Ignores all multi-merchant configs and treats entire site as a single merchant using site preferences only. Configurations saved in custom objects/cache, if available will be ignored. Default: false (disabled - use site preferences only)</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>

            <attribute-definition attribute-id="JPMCEnableFraudCheck">
                <display-name xml:lang="x-default">Enable JPMC Fraud Check (Handle)</display-name>
                <description xml:lang="x-default">Enable fraud check validation during payment verification (basket stage, before payment instrument is verified). Transactions declined by fraud rules (fraudRuleAction = "D") will be blocked. Default: false</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>

            <attribute-definition attribute-id="JPMCEnableFraudCheckAtAuth">
                <display-name xml:lang="x-default">Enable JPMC Fraud Check (Authorize)</display-name>
                <description xml:lang="x-default">Enable fraud check validation before payment authorization (order stage, before payment is authorized). Transactions declined by fraud rules (fraudRuleAction = "D") will be blocked and order data will be stored. Default: false</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>

            <attribute-definition attribute-id="JPMCEnableAVS">
                <display-name xml:lang="x-default">Enable Address Verification Service (AVS)</display-name>
                <description xml:lang="x-default">Enable Address Verification Service to include billing address in Verify Payment and Authorization API payloads. When enabled, billing address is sent to JPMC for address verification checks. Note: Billing address is always included in Fraud Check payloads regardless of this setting. Default: true</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>true</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCGooglePayEnvironment">
                <display-name xml:lang="x-default">JPMC Google Pay Environment</display-name>
                <description xml:lang="x-default">Google Pay environment: TEST for development/sandbox, PRODUCTION for live. Default: TEST</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Test</display>
                        <value>TEST</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Production</display>
                        <value>PRODUCTION</value>
                    </value-definition>
                </value-definitions>
                <default-value>TEST</default-value>
            </attribute-definition>

            <attribute-definition attribute-id="JPMCGooglePayGatewayMerchantId">
                <display-name xml:lang="x-default">JPMC Google Pay Gateway Merchant ID</display-name>
                <description xml:lang="x-default">Gateway merchant ID provided by Chase for Google Pay tokenization</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="JPMCGooglePayMerchantId">
                <display-name xml:lang="x-default">JPMC Google Pay Merchant ID</display-name>
                <description xml:lang="x-default">Google Pay merchant ID from Google Pay Business Console (required for PRODUCTION environment)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="JPMCGooglePayMerchantName">
                <display-name xml:lang="x-default">JPMC Google Pay Merchant Name</display-name>
                <description xml:lang="x-default">Merchant name displayed to the shopper in the Google Pay payment sheet</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="JPMCGooglePayAllowedCardNetworks">
                <display-name xml:lang="x-default">JPMC Google Pay Allowed Card Networks</display-name>
                <description xml:lang="x-default">Comma-separated list of allowed card networks for Google Pay. Example: VISA,MASTERCARD,AMEX,DISCOVER</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="JPMCGooglePayGateway">
                <display-name xml:lang="x-default">JPMC Google Pay Gateway</display-name>
                <description xml:lang="x-default">Payment gateway identifier for Google Pay tokenization (e.g. chase)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="JPMCGooglePayAllowedAuthMethods">
                <display-name xml:lang="x-default">JPMC Google Pay Allowed Auth Methods</display-name>
                <description xml:lang="x-default">Comma-separated list of allowed authentication methods for Google Pay. Example: PAN_ONLY,CRYPTOGRAM_3DS</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCGooglePayCartEnabled">
                <display-name xml:lang="x-default">JPMC Google Pay Cart Enabled</display-name>
                <description xml:lang="x-default">Enable Google Pay button on the cart page for express checkout. When enabled, shoppers can complete purchase directly from the cart page.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCGooglePayPDPEnabled">
                <display-name xml:lang="x-default">JPMC Google Pay PDP Enabled</display-name>
                <description xml:lang="x-default">Enable Google Pay button on product detail pages for Buy Now checkout. When enabled, shoppers can purchase directly from the product page.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="jpmc_kid">
                <display-name xml:lang="x-default">JPMC Key ID (kid)</display-name>
                <description xml:lang="x-default">SHA-1 hex thumbprint (uppercase, 40 characters) for JWT kid claim. Generate via BM &gt; Merchant Tools &gt; JPMC Tools &gt; Certificate Thumbprint Generator.</description>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCApiHost">
                <display-name xml:lang="x-default">JPMC API Host</display-name>
                <description xml:lang="x-default">JPMC Payment API base URL (without https://). Examples: api-ms-test.payments.jpmorgan.com (sandbox), api-ms.payments.jpmorgan.com (production). If not set, derived from JPMCEnvironment.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCEnvironment">
                <display-name xml:lang="x-default">JPMC Environment</display-name>
                <description xml:lang="x-default">JPMC environment: sandbox (CAT/TEST) or production. Used to determine API host if JPMCApiHost is not set. Default: sandbox</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Sandbox (CAT/TEST)</display>
                        <value>sandbox</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Production</display>
                        <value>production</value>
                    </value-definition>
                </value-definitions>
                <default-value>sandbox</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCTokenURI">
                <display-name xml:lang="x-default">JPMCTokenURI</display-name>
                <description xml:lang="x-default">PWA is using it</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCCertAlias">
                <display-name xml:lang="x-default">JPMC Certificate Alias</display-name>
                <description xml:lang="x-default">Alias of the X.509 certificate in BM Certificate Manager (Administration > Operations > Private Keys and Certificates)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCPrivateKeyAlias">
                <display-name xml:lang="x-default">JPMC Private Key Alias</display-name>
                <description xml:lang="x-default">Alias of the private key in BM Certificate Manager (Administration > Operations > Private Keys and Certificates)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcKountClientId">
                <display-name xml:lang="x-default">Kount Client ID</display-name>
                <description xml:lang="x-default">Kount Web Client SDK Client ID (6-digit merchant ID from J.P.Morgan). Required when fraud check is enabled. Provided by Kount during onboarding. Example: 300002</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcKountEnvironment">
                <display-name xml:lang="x-default">Kount Environment</display-name>
                <description xml:lang="x-default">Kount environment: TEST for sandbox/development, PROD for production. Default: TEST</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Test</display>
                        <value>TEST</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Production</display>
                        <value>PROD</value>
                    </value-definition>
                </value-definitions>
                <default-value>TEST</default-value>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="JPMC_Payment">
                <display-name xml:lang="x-default">JPMC Payment Configuration</display-name>
                <attribute attribute-id="JPMCClientID"/>
                <attribute attribute-id="JPMC_MerchantCode"/>
                <attribute attribute-id="JPMCTokenizationType"/>
                <attribute attribute-id="JPMCCaptureMethod"/>
                <attribute attribute-id="JPMCEnableFraudCheck"/>
                <attribute attribute-id="JPMCEnableFraudCheckAtAuth"/>
                <attribute attribute-id="jpmcKountClientId"/>
                <attribute attribute-id="jpmcKountEnvironment"/>
                <attribute attribute-id="JPMCEnableAVS"/>
                <attribute attribute-id="JPMCResourceID"/>
                <attribute attribute-id="JPMCAudience"/>
                <attribute attribute-id="JPMCExpiresIn"/>
                <attribute attribute-id="JPMCGetKeyUrl"/>
                <attribute attribute-id="JPMCEncryptionUrl"/>
                <attribute attribute-id="JPMCPlatformId"/>
            </attribute-group>
            <attribute-group group-id="JPMC_PWA">
                <display-name xml:lang="x-default">JPMC PWA Configurations</display-name>
                <attribute attribute-id="JPMCTokenURI"/>
                <attribute attribute-id="JPMCApiHost"/>
                <attribute attribute-id="JPMCEnvironment"/>
                <attribute attribute-id="JPMCGooglePayAllowedShippingCountries"/>
            </attribute-group>
            <attribute-group group-id="JPMC_ApplePay">
                <display-name xml:lang="x-default">JPMC Apple Pay Configuration</display-name>
                <attribute attribute-id="JPMCApplePayEnabled"/>
                <attribute attribute-id="JPMCApplePayMerchantId"/>
                <attribute attribute-id="JPMCApplePayMerchantName"/>
                <attribute attribute-id="JPMCApplePayCountryCode"/>
                <attribute attribute-id="JPMCApplePaySupportedNetworks"/>
                <attribute attribute-id="JPMCApplePayMerchantCapabilities"/>
            </attribute-group>
            <attribute-group group-id="JPMC_GooglePay">
                <display-name xml:lang="x-default">JPMC Google Pay Configuration</display-name>
                <attribute attribute-id="JPMCGooglePayEnvironment"/>
                <attribute attribute-id="JPMCGooglePayGatewayMerchantId"/>
                <attribute attribute-id="JPMCGooglePayMerchantId"/>
                <attribute attribute-id="JPMCGooglePayMerchantName"/>
                <attribute attribute-id="JPMCGooglePayGateway"/>
                <attribute attribute-id="JPMCGooglePayAllowedCardNetworks"/>
                <attribute attribute-id="JPMCGooglePayAllowedAuthMethods"/>
                <attribute attribute-id="JPMCGooglePayCartEnabled"/>
                <attribute attribute-id="JPMCGooglePayPDPEnabled"/>
            </attribute-group>
            <attribute-group group-id="JPMC_Certificate_SFRA">
                <display-name xml:lang="x-default">JPMC Certificate &amp; JWT Settings for SFRA</display-name>
                <attribute attribute-id="JPMCCertAlias"/>
                <attribute attribute-id="JPMCPrivateKeyAlias"/>
                <attribute attribute-id="jpmc_kid"/>
            </attribute-group>
            <attribute-group group-id="JPMC_MultiMerchant">
                <display-name xml:lang="x-default">JPMC Multi Merchant Settings</display-name>
                <attribute attribute-id="JPMCEnableMultiMerchant"/>
            </attribute-group>
        </group-definitions>
    </type-extension>
    <type-extension type-id="OrderPaymentInstrument">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="jpmcTransactionId">
                <display-name xml:lang="x-default">JPMC Transaction ID</display-name>
                <description xml:lang="x-default">Authorization transaction ID returned from JPMC payment service</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcGooglePayToken">
                <display-name xml:lang="x-default">JPMC Google Pay Token (Temporary)</display-name>
                <description xml:lang="x-default">Temporary storage for Google Pay encrypted payment bundle. Cleared after authorization for security.</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcWalletProvider">
                <display-name xml:lang="x-default">JPMC Wallet Provider</display-name>
                <description xml:lang="x-default">Wallet provider used for payment (e.g., GOOGLE_PAY, APPLE_PAY)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcMerchantId">
                <display-name xml:lang="x-default">JPMC Merchant ID</display-name>
                <description xml:lang="x-default">Merchant ID used to process this payment instrument. Stamped during Handle() for multi-merchant routing at authorize time.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="kountSessionId">
                <display-name xml:lang="x-default">Kount Session ID</display-name>
                <description xml:lang="x-default">Kount device fingerprinting session ID for fraud detection. Captured from checkout form and passed to JPMC fraud check API.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <field-length>255</field-length>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcFraudRuleAction">
                <display-name xml:lang="x-default">JPMC Fraud Rule Action</display-name>
                <description xml:lang="x-default">Fraud rule action from verify stage (A=Accept, D=Decline, E=Manager Review, R=Review). Used to determine capture method override when flagged for review.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <field-length>1</field-length>
            </attribute-definition>
        </custom-attribute-definitions>
    </type-extension>
    <type-extension type-id="Order">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="jpmcFraudTransactionId">
                <display-name xml:lang="x-default">JPMC Fraud Transaction ID</display-name>
                <description xml:lang="x-default">Transaction ID returned from JPMC fraud check service</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <field-length>255</field-length>
            </attribute-definition>
              <attribute-definition attribute-id="jpmcMerchantId">
                <display-name xml:lang="x-default">JPMC Merchant ID</display-name>
                <description xml:lang="x-default">Merchant ID used for this order's payment. Used by BM CSC extension to resolve the correct merchant config for capture/refund/void operations.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcFraudRiskElement">
                <display-name xml:lang="x-default">JPMC Fraud Risk Element</display-name>
                <description xml:lang="x-default">Risk element from fraud check</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <field-length>50</field-length>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcFraudRiskDecision">
                <display-name xml:lang="x-default">JPMC Fraud Risk Decision</display-name>
                <description xml:lang="x-default">Fraud risk decision from JPMC fraud</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcFraudCheckDate">
                <display-name xml:lang="x-default">JPMC Fraud Check Date</display-name>
                <description xml:lang="x-default">Date and time when fraud check was performed</description>
                <type>datetime</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="jpmcFraudResponse">
                <display-name xml:lang="x-default">JPMC Fraud Response</display-name>
                <description xml:lang="x-default">Complete JSON response from JPMC fraud check API for debugging and audit purposes</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="kountSessionId">
                <display-name xml:lang="x-default">Kount Session ID</display-name>
                <description xml:lang="x-default">Kount device fingerprinting session ID for fraud detection. Stored from payment instrument for order-level tracking and reporting.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <field-length>255</field-length>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="JPMCFraudCheck">
                <display-name xml:lang="x-default">JPMC Fraud Check</display-name>
                <attribute attribute-id="jpmcFraudTransactionId"/>
                <attribute attribute-id="jpmcFraudRiskElement"/>
