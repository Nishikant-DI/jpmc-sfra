<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
      <custom-type type-id="JPMCAccessToken">
        <display-name xml:lang="x-default">JPMC Access Token</display-name>
        <description xml:lang="x-default">Stores JPMC OAuth2 access tokens with expiration metadata. Keyed by siteID::localeID (e.g. RefArch::en_US) for locale-specific token management.</description>
        <staging-mode>no-staging</staging-mode>
        <storage-scope>site</storage-scope>
        <key-definition attribute-id="tokenKey">
            <display-name xml:lang="x-default">Token Key</display-name>
            <description xml:lang="x-default">Composite key: {siteID}::{localeID} (e.g. RefArch::en_US)</description>
            <type>string</type>
            <min-length>0</min-length>
        </key-definition>
        <attribute-definitions>
            <attribute-definition attribute-id="accessToken">
                <display-name xml:lang="x-default">Access Token</display-name>
                <description xml:lang="x-default">OAuth2 access token from JPMC</description>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="expiresAt">
                <display-name xml:lang="x-default">Expires At</display-name>
                <description xml:lang="x-default">Timestamp when token expires</description>
                <type>string</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="expiresIn">
                <display-name xml:lang="x-default">Expires In (Seconds)</display-name>
                <description xml:lang="x-default">Token validity duration in seconds</description>
                <type>string</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="issuedAt">
                <display-name xml:lang="x-default">Issued At</display-name>
                <description xml:lang="x-default">Timestamp when token was created</description>
                <type>string</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="type">
                <display-name xml:lang="x-default">Token Type</display-name>
                <description xml:lang="x-default">Type identifier for the token (always jpmc_access_token)</description>
                <type>string</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
        </attribute-definitions>
        <group-definitions>
            <attribute-group group-id="JPMCAccessToken">
                <display-name xml:lang="x-default">JPMCAccessToken</display-name>
                <attribute attribute-id="type"/>
                <attribute attribute-id="expiresAt"/>
                <attribute attribute-id="issuedAt"/>
                <attribute attribute-id="expiresIn"/>
                <attribute attribute-id="creationDate" system="true"/>
                <attribute attribute-id="lastModified" system="true"/>
                <attribute attribute-id="tokenKey"/>
                <attribute attribute-id="accessToken"/>
            </attribute-group>
        </group-definitions>
    </custom-type>

    <custom-type type-id="AccountUpdater_Notification_Queue">
        <display-name xml:lang="x-default">Account Updater Notification Queue</display-name>
        <description xml:lang="x-default">Durable queue for incoming Account Updater webhook notifications. Records are processed by the ProcessUpdateQueue_Job and deleted on success. Contains no card data — the unmasked tokens are fetched at processing time via the JPMC GET API.</description>
        <staging-mode>no-staging</staging-mode>
        <storage-scope>site</storage-scope>
        <key-definition attribute-id="notificationID">
            <type>string</type>
            <min-length>1</min-length>
        </key-definition>
        <attribute-definitions>
            <attribute-definition attribute-id="transactionId">
                <display-name xml:lang="x-default">Transaction ID</display-name>
                <description xml:lang="x-default">JPMC transactionId used for the GET /account-updates/{transactionId} call to retrieve unmasked card data.</description>
                <type>string</type>
                <mandatory-flag>true</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="merchantId">
                <display-name xml:lang="x-default">Merchant ID</display-name>
                <description xml:lang="x-default">Top-level merchantId from the webhook payload. Used to resolve merchant config for the GET API call.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="reasonMessage">
                <display-name xml:lang="x-default">Reason Message</display-name>
                <description xml:lang="x-default">Provider reasonMessage that triggered the queue entry (e.g. NEW_ACCOUNT, NEW_EXPIRY, NEW_ACCOUNT_AND_EXPIRY).</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="merchantRecordIdentifier">
                <display-name xml:lang="x-default">Merchant Record Identifier</display-name>
                <description xml:lang="x-default">Composite identifier in the format {paymentInstrumentUUID}-CN-{customerNumber} used to locate the wallet PaymentInstrument.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="status">
                <display-name xml:lang="x-default">Processing Status</display-name>
                <description xml:lang="x-default">Current processing state: NEW (awaiting), PROCESSING (locked), ERROR (failed)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">New</display>
                        <value>NEW</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Processing</display>
                        <value>PROCESSING</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Error</display>
                        <value>ERROR</value>
                    </value-definition>
                </value-definitions>
                <default-value>NEW</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="retryCount">
                <display-name xml:lang="x-default">Retry Count</display-name>
                <description xml:lang="x-default">Number of failed processing attempts for this notification. Reserved for future retry logic.</description>
                <type>int</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <default-value>0</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="receivedTimestamp">
                <display-name xml:lang="x-default">Received Timestamp</display-name>
                <description xml:lang="x-default">Server timestamp when the webhook was received</description>
                <type>datetime</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="lastError">
                <display-name xml:lang="x-default">Last Error</display-name>
                <description xml:lang="x-default">Error message from the last failed processing attempt. Does not contain PII.</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
        </attribute-definitions>
        <group-definitions>
            <attribute-group group-id="AccountUpdater_Queue">
                <display-name xml:lang="x-default">Account Updater Queue</display-name>
                <attribute attribute-id="notificationID"/>
                <attribute attribute-id="transactionId"/>
                <attribute attribute-id="merchantId"/>
                <attribute attribute-id="reasonMessage"/>
                <attribute attribute-id="merchantRecordIdentifier"/>
                <attribute attribute-id="status"/>
                <attribute attribute-id="retryCount"/>
                <attribute attribute-id="receivedTimestamp"/>
                <attribute attribute-id="lastError"/>
                <attribute attribute-id="creationDate" system="true"/>
                <attribute attribute-id="lastModified" system="true"/>
            </attribute-group>
        </group-definitions>
    </custom-type>


            
    <custom-type type-id="JPMCMerchantConfig">
        <display-name xml:lang="x-default">JPMC Merchant Configuration</display-name>
        <description xml:lang="x-default">Stores per-merchant JPMC payment configuration. Keyed by siteID::localeID (e.g. SiteA::en_CA) or siteID::default for site-wide config. Resolution order: locale-specific → site-default → site preferences fallback.</description>
        <staging-mode>no-staging</staging-mode>
        <storage-scope>site</storage-scope>
        <key-definition attribute-id="configKey">
            <display-name xml:lang="x-default">Config Key</display-name>
            <description xml:lang="x-default">Composite key: {siteID}::{localeID} or {siteID}::default</description>
            <type>string</type>
            <min-length>0</min-length>
        </key-definition>
        <attribute-definitions>
            <attribute-definition attribute-id="enabled">
                <display-name xml:lang="x-default">Enabled</display-name>
                <description xml:lang="x-default">Master switch for this merchant configuration</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <default-value>true</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="merchantId">
                <display-name xml:lang="x-default">Merchant ID</display-name>
                <description xml:lang="x-default">JPMC Merchant Code (equivalent to JPMC_MerchantCode site preference)</description>
                <type>string</type>
                <mandatory-flag>true</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="merchantCategoryCode">
                <display-name xml:lang="x-default">Merchant Category Code</display-name>
                <description xml:lang="x-default">Merchant Category Code (MCC) - 4-digit code identifying merchant business type. Must be exactly 4 digits. If not configured, defaults to MCC set at JPMC merchant profile level.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <regex>^\d{4}$</regex>
            </attribute-definition>
            <attribute-definition attribute-id="clientId">
                <display-name xml:lang="x-default">Client ID</display-name>
                <description xml:lang="x-default">OAuth2 Client ID from J.P.Morgan</description>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="resourceId">
                <display-name xml:lang="x-default">Resource ID</display-name>
                <description xml:lang="x-default">OAuth2 Resource ID from J.P.Morgan</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Test/CAT</display>
                        <value>JPMC:URI:RS-105239-85484-HelixAPIEntitlementsCAT-PROD</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Production</display>
                        <value>JPMC:URI:RS-105239-85485-HelixAPIEntitlements-PROD</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="certAlias">
                <display-name xml:lang="x-default">Certificate Alias</display-name>
                <description xml:lang="x-default">Alias of the X.509 certificate in BM Certificate Manager. Naming convention: jpmc-cert-{merchantName}</description>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="privateKeyAlias">
                <display-name xml:lang="x-default">Private Key Alias</display-name>
                <description xml:lang="x-default">Alias of the private key in BM Certificate Manager. Naming convention: jpmc-key-{merchantName}</description>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="kid">
                <display-name xml:lang="x-default">Key ID (kid)</display-name>
                <description xml:lang="x-default">SHA-1 hex thumbprint (uppercase, 40 characters) for JWT kid claim</description>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="pieGetKeyUrl">
                <display-name xml:lang="x-default">PIE Base URL</display-name>
                <description xml:lang="x-default">Base URL for JPMC Page Integrated Encryption (PIE). Combined with pieKey to build the full getkey.js URL: {pieGetKeyUrl}/{pieKey}/getkey.js</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Test/CAT</display>
                        <value>https://safetechpageencryptionvar.chasepaymentech.com/pie/v1</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Production</display>
                        <value>https://safetechpageencryption.chasepaymentech.com/pie/v1</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="pieEncryptionUrl">
                <display-name xml:lang="x-default">PIE Encryption URL</display-name>
                <description xml:lang="x-default">URL for JPMC PIE encryption.js script.</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Test/CAT</display>
                        <value>https://safetechpageencryptionvar.chasepaymentech.com/pie/v1/encryption.js</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Production</display>
                        <value>https://safetechpageencryption.chasepaymentech.com/pie/v1/encryption.js</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="pieKey">
                <display-name xml:lang="x-default">PIE Key</display-name>
                <description xml:lang="x-default">Page Encryption (PE) Key ID from J.P.Morgan. Appended to pieGetKeyUrl to construct the full getkey.js URL.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="captureMethod">
                <display-name xml:lang="x-default">Capture Method</display-name>
                <description xml:lang="x-default">Payment capture method: MANUAL (auth only), DELAYED, NOW (immediate sale). Defaults to site preference if blank.</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Manual (Authorization Only)</display>
                        <value>MANUAL</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Delayed Capture</display>
                        <value>DELAYED</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Immediate Sale (NOW)</display>
                        <value>NOW</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="platformId">
                <display-name xml:lang="x-default">Platform ID</display-name>
                <description xml:lang="x-default">Optional JPMC Platform ID</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="googlePayGatewayMerchantId">
                <display-name xml:lang="x-default">Google Pay Gateway Merchant ID</display-name>
                <description xml:lang="x-default">Gateway merchant ID provided by Chase for Google Pay tokenization</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="googlePayMerchantId">
                <display-name xml:lang="x-default">Google Pay Merchant ID</display-name>
                <description xml:lang="x-default">Google Pay merchant ID from Google Pay Business Console (required for PRODUCTION)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="googlePayMerchantName">
                <display-name xml:lang="x-default">Google Pay Merchant Name</display-name>
                <description xml:lang="x-default">Merchant display name in the Google Pay payment sheet</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="googlePayEnvironment">
                <display-name xml:lang="x-default">Google Pay Environment</display-name>
                <description xml:lang="x-default">Google Pay environment: TEST or PRODUCTION</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Test</display>
                        <value>TEST</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Production</display>
                        <value>PRODUCTION</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="kountClientId">
                <display-name xml:lang="x-default">Safetech Fraud Client ID</display-name>
                <description xml:lang="x-default">Safetech Fraud Web Client SDK Client ID for this merchant</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="kountEnvironment">
                <display-name xml:lang="x-default">Safetech Fraud Environment</display-name>
                <description xml:lang="x-default">Safetech Fraud environment: TEST for sandbox/development, PROD for production.</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Test</display>
                        <value>TEST</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Production</display>
                        <value>PROD</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="enableFraudCheck">
                <display-name xml:lang="x-default">Enable Fraud Check (Handle)</display-name>
                <description xml:lang="x-default">Enable fraud check validation during payment verification (basket stage). Transactions declined by fraud rules will be blocked.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="enableFraudCheckAtAuth">
                <display-name xml:lang="x-default">Enable Fraud Check (Authorize)</display-name>
                <description xml:lang="x-default">Enable fraud check validation before payment authorization (order stage). Transactions declined by fraud rules will be blocked and order data stored.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="enableAVS">
                <display-name xml:lang="x-default">Enable Address Verification Service (AVS)</display-name>
                <description xml:lang="x-default">Include billing address in Verify Payment and Authorization API payloads for address verification checks.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <default-value>true</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="tokenizationType">
                <display-name xml:lang="x-default">Tokenization Type</display-name>
                <description xml:lang="x-default">Default tokenization type for payment transactions.</description>
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <value-definitions>
                    <value-definition>
                        <display xml:lang="x-default">Safetech Token</display>
                        <value>SAFETECH_TOKEN</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">Network Token</display>
                        <value>NETWORK_TOKEN</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="googlePayGateway">
                <display-name xml:lang="x-default">Google Pay Gateway</display-name>
                <description xml:lang="x-default">Payment gateway identifier for Google Pay tokenization (e.g. chase)</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="googlePayAllowedCardNetworks">
                <display-name xml:lang="x-default">Google Pay Allowed Card Networks</display-name>
                <description xml:lang="x-default">Comma-separated list of allowed card networks. Example: VISA,MASTERCARD,AMEX,DISCOVER</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="googlePayAllowedAuthMethods">
                <display-name xml:lang="x-default">Google Pay Allowed Auth Methods</display-name>
                <description xml:lang="x-default">Comma-separated list of allowed authentication methods. Example: PAN_ONLY,CRYPTOGRAM_3DS</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCGooglePayCartEnabled">
                <display-name xml:lang="x-default">Enable Google Pay on Cart</display-name>
                <description xml:lang="x-default">Show Google Pay button on the cart page in addition to checkout.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="JPMCGooglePayPDPEnabled">
                <display-name xml:lang="x-default">Enable Google Pay on PDP</display-name>
                <description xml:lang="x-default">Show Google Pay button on the product detail page.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>

            <attribute-definition attribute-id="jpmcAccountUpdaterWebhookUser">
                <display-name xml:lang="x-default">Account Updater Webhook Username</display-name>
                <description xml:lang="x-default">Username (client ID) used in the Authorization: Basic header for authenticating incoming webhook requests. Combined with the webhook secret as base64(username:secret).</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcAccountUpdaterWebhookSecret">
                <display-name xml:lang="x-default">Account Updater Webhook Secret</display-name>
                <description xml:lang="x-default">Password used in the Authorization: Basic header for authenticating incoming webhook requests. Combined with the webhook username as base64(username:secret).</description>
                <type>password</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="jpmcAccountUpdaterMode">
                <display-name xml:lang="x-default">Account Updater Mode</display-name>
                <description xml:lang="x-default">Controls which Account Updater flows are active for this merchant configuration. NONE disables the feature. NOTIFICATIONS enables the asynchronous webhook flow only. REAL_TIME enables Real-Time Account Updater (RTAU) on stored-card authorization only. BOTH enables both flows. If blank, falls back to the site preference value. Default: NONE</description>
