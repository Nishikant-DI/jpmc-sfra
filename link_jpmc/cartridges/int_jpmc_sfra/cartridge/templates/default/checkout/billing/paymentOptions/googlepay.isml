    <fieldset class="payment-form-fields">

        <input type="hidden" class="form-control"
               name="${pdict.forms.billingForm.paymentMethod.htmlName}"
               value="JPMC_GOOGLE_PAY"
        />

        <div class="googlepay-button-container">
            <div id="googlepay-button-wrapper" class="text-center"
                 data-config-url="${URLUtils.https('JpmcGooglePay-GetConfig')}"
                 data-store-url="${URLUtils.https('JpmcGooglePay-StoreToken')}"
                 data-clear-url="${URLUtils.https('JpmcGooglePay-ClearToken')}"
                 data-gpay-context="checkout">
            </div>

            <div id="googlepay-error" class="googlepay-error text-center mt-3 text-danger d-none">
                <span>${Resource.msg('error.technical', 'checkout', null)}</span>
            </div>
        </div>

    </fieldset>