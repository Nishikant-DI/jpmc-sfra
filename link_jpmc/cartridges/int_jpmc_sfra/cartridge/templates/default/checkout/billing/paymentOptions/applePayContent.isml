
<div class="tab-pane apple-pay-content" id="apple-pay-content" role="tabpanel">
    <fieldset class="payment-form-fields">
        <legend class="sr-only">
            ${Resource.msg('label.payment.applepay', 'checkout', null)}
        </legend>
        
        <div class="row">
            <div class="col-12">
                <div class="apple-pay-button-container text-center">
                    <isapplepay class="apple-pay-checkout-btn"></isapplepay>
                    
                    <div class="apple-pay-unavailable d-none">
                        <p class="text-muted">
                            ${Resource.msg('msg.applepay.unavailable', 'checkout', null)}
                        </p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-12">
                <p class="apple-pay-info text-muted small text-center mt-2">
                    ${Resource.msg('msg.applepay.info', 'checkout', null)}
                </p>
            </div>
        </div>
    </fieldset>
</div>
