{
    "step-types": {
        "script-module-step": [
            {
                "@type-id": "custom.JPMCMerchantCacheWarmup",
                "@supports-parallel-execution": false,
                "@supports-site-context": true,
                "@supports-organization-context": false,
                "description": "Pre-warms the JPMC merchant configuration cache for all allowed locales on the current site.",
                "module": "int_jpmc_core/cartridge/scripts/jobs/JPMCMerchantCacheWarmup.js",
                "function": "execute",
                "transactional": false,
                "timeout-in-seconds": 60,
                "parameters": {},
                "status-codes": {
                    "status": [
                        {
                            "@code": "OK",
                            "description": "Cache warmed successfully for all locales"
                        },
                        {
                            "@code": "ERROR",
                            "description": "One or more cache warmup entries failed"
                        }
                    ]
                }
            },
            {
                "@type-id": "custom.JPMCClearExhaustedUpdateQueue",
                "@supports-parallel-execution": false,
                "@supports-site-context": true,
                "@supports-organization-context": false,
                "description": "Deletes exhausted Account Updater queue records in ERROR status where retryCount has reached maxRetries.",
                "module": "int_jpmc_core/cartridge/scripts/jobs/JPMCClearExhaustedUpdateQueue.js",
                "function": "execute",
                "transactional": false,
                "timeout-in-seconds": 60,
                "parameters": {
                    "parameter": [
                        {
                            "@name": "maxRetries",
                            "@type": "long",
                            "@required": false,
                            "description": "Maximum failed attempts before an ERROR queue record is deleted",
                            "default-value": "5"
                        }
                    ]
                },
                "status-codes": {
                    "status": [
                        {
                            "@code": "OK",
                            "description": "Cleanup completed successfully"
                        },
                        {
                            "@code": "ERROR",
                            "description": "Cleanup failed"
                        }
                    ]
                }
            }
        ],
        "chunk-script-module-step": [
            {
                "@type-id": "custom.JPMCProcessUpdateQueue",
                "@supports-parallel-execution": "false",
                "@supports-site-context": "true",
                "@supports-organization-context": "false",
                "description": "Processes Account Updater notification queue. Reads queued COs, calls GET /account-updates/{transactionId} to retrieve unmasked tokens, and updates customer wallets.",
                "module": "int_jpmc_core/cartridge/scripts/jobs/ProcessUpdateQueue.js",
                "before-step-function": "beforeStep",
                "total-count-function": "getTotalCount",
                "before-chunk-function": "",
                "read-function": "read",
                "process-function": "process",
                "write-function": "write",
                "after-chunk-function": "",
                "after-step-function": "afterStep",
                "chunk-size": 10,
                "transactional": "false",
                "parameters": {},
                "status-codes": {
                    "status": [
                        {
                            "@code": "ERROR",
                            "description": "Job encountered errors during processing"
                        },
                        {
                            "@code": "OK",
                            "description": "Job completed successfully"
                        }
                    ]
                }
            }
        ]
    }
}
