<isdecorate template="application/MenuFrame">
<iscontent type="text/html" charset="UTF-8" compact="true"/>

<link rel="stylesheet" href="${URLUtils.staticURL('/css/bmMultiMerchant.css')}" />

<div class="jpmc-merchant-list">
    <h1>${Resource.msg('webhook.title','jpmcbm', null)}</h1>

    <isif condition="${!empty(pdict.message)}">
        <div class="info-panel" role="status">
            <isprint value="${pdict.message}" encoding="htmlcontent"/>
        </div>
    </isif>
    <isif condition="${!empty(pdict.error)}">
        <div class="error-message" role="alert">
            <isprint value="${pdict.error}" encoding="htmlcontent"/>
        </div>
    </isif>

    <div class="info-panel">
        <h2>${Resource.msg('webhook.about.title','jpmcbm', null)}</h2>
        <p>${Resource.msg('webhook.about.description','jpmcbm', null)}</p>
    </div>

    <div class="table-wrapper">
        <isif condition="${!empty(pdict.rows) && pdict.rows.length > 0}">
            <table class="config-table" summary="${Resource.msg('webhook.table.summary','jpmcbm', null)}">
                <thead>
                    <tr>
                        <th class="col-locale" scope="col">${Resource.msg('webhook.col.scope','jpmcbm', null)}</th>
                        <th class="col-merchant" scope="col">${Resource.msg('webhook.col.merchantId','jpmcbm', null)}</th>
                        <th scope="col">${Resource.msg('webhook.col.subscriptionId','jpmcbm', null)}</th>
                        <th scope="col">${Resource.msg('webhook.col.status','jpmcbm', null)}</th>
                        <th class="col-actions" scope="col">${Resource.msg('webhook.col.actions','jpmcbm', null)}</th>
                    </tr>
                </thead>
                <tbody>
                    <isloop items="${pdict.rows}" var="row" status="loop">
                        <tr class="${loop.index % 2 === 0 ? 'row-even' : 'row-odd'}">
                            <td class="col-locale"><strong><isprint value="${row.locale}" encoding="htmlcontent"/></strong></td>
                            <td class="col-merchant"><isprint value="${row.merchantId}" encoding="htmlcontent"/></td>
                            <td>
                                <isif condition="${!empty(row.subscriptionId)}">
                                    <isprint value="${row.subscriptionId}" encoding="htmlcontent"/>
                                <iselse/>
                                    ${Resource.msg('webhook.value.empty','jpmcbm', null)}
                                </isif>
                            </td>
                            <td>
                                <isif condition="${row.subscribed}">
                                    ${Resource.msg('webhook.status.active','jpmcbm', null)}
                                <iselse/>
                                    ${Resource.msg('webhook.status.inactive','jpmcbm', null)}
                                </isif>
                            </td>
                            <td class="col-actions">
                                <isif condition="${row.subscribed}">
                                    <a href="${URLUtils.url('JPMCWebhookManager-Update', 'configKey', row.configKey, pdict.csrf.tokenName, pdict.csrf.token)}"
                                       onclick="return confirm('<isprint value="${Resource.msg('webhook.confirm.update','jpmcbm', null)}" encoding="jshtml"/>');"
                                       class="link-edit">${Resource.msg('webhook.btn.update','jpmcbm', null)}</a>
                                    <span class="divider" role="presentation">${Resource.msg('webhook.action.divider','jpmcbm', null)}</span>
                                    <a href="${URLUtils.url('JPMCWebhookManager-Delete', 'configKey', row.configKey, pdict.csrf.tokenName, pdict.csrf.token)}"
                                       onclick="return confirm('<isprint value="${Resource.msg('webhook.confirm.delete','jpmcbm', null)}" encoding="jshtml"/>');"
                                       class="link-delete">${Resource.msg('webhook.btn.delete','jpmcbm', null)}</a>
                                <iselse/>
                                    <a href="${URLUtils.url('JPMCWebhookManager-Subscribe', 'configKey', row.configKey, pdict.csrf.tokenName, pdict.csrf.token)}"
                                       class="link-edit">${Resource.msg('webhook.btn.subscribe','jpmcbm', null)}</a>
                                </isif>
                            </td>
                        </tr>
                    </isloop>
                </tbody>
            </table>
        <iselse/>
            <div class="empty-state">
                <div class="empty-state-content">
                    <h3>${Resource.msg('webhook.empty','jpmcbm', null)}</h3>
                </div>
            </div>
        </isif>
    </div>

    <div class="info-panel">
        <h2>${Resource.msg('webhook.note.title','jpmcbm', null)}</h2>
        <p>${Resource.msg('webhook.note.body','jpmcbm', null)}</p>
    </div>
</div>
</isdecorate>
